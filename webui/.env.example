# Open5GS MongoDB (HSS/UDR subscriber store)
DB_URI=mongodb://127.0.0.1:27017/open5gs

# Bind address for the WebUI
HOSTNAME=0.0.0.0
PORT=9999

# Telebey ApiGate (https://github.com/TelebeyISP/ApiGate.git)
APIGATE_URL=http://127.0.0.1:4000
APIGATE_TIMEOUT_MS=4000

# Optional service login used to list SIMs from ApiGate (never commit real secrets)
# APIGATE_EMAIL=admin@telebey.com
# APIGATE_PASSWORD=
# APIGATE_TOKEN=
